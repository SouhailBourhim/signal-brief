# Project runtime
# NB: .gitignore has no trailing-comment syntax — a comment after a pattern becomes part
# of the pattern, and the rule silently stops matching.
# local bronze/silver/gold roots
data/
# rendered briefs
out/
# read-once bronze object cache (SPEC 6.2)
.cache/
# Lambda deployment artifact, rebuilt by `make lambda-package`
build/
*.log

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
credentials


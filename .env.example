# Copy to .env (gitignored). Never commit real values.

# SEC requires a descriptive User-Agent with a contact email (SPEC 6.2).
SIGNAL_CONTACT_EMAIL=you@example.com

# Local data roots. In AWS these become s3://signal-bronze etc.
SIGNAL_DATA_ROOT=./data
SIGNAL_OUT_ROOT=./out
SIGNAL_CACHE_ROOT=./.cache

# Ollama runs natively on the host, not in Docker (ADR-0002).
#   WSL2 -> http://host.docker.internal:11434
#   Linux -> http://172.17.0.1:11434
SIGNAL_OLLAMA_URL=http://localhost:11434

# Phase 1 targets. All three are `terraform -chdir=infra/terraform/main output`.
# SIGNAL_ICEBERG_WAREHOUSE doubles as the catalog switch: an s3:// URI selects Glue +
# S3FileIO, anything else a local Hadoop catalog (see spark/session.py).
SIGNAL_BRONZE_BUCKET=signal-bronze
SIGNAL_ICEBERG_WAREHOUSE=
SIGNAL_STATE_TABLE_NAME=signal-pipeline-state

# Run the Airflow containers as your host uid, so the read-only ~/.aws mount is readable
# (it is 0600 and owned by you) and files written to ./data and ./out are yours rather
# than uid 50000's. Set it to `id -u` on the machine running compose.
AIRFLOW_UID=50000

# The Airflow UI binds to loopback. That container mounts ~/.aws read-only and its JWT
# secret below defaults to a literal, so publishing it on 0.0.0.0 puts real AWS credentials
# one weak default away from anyone on the same network. Set this to 0.0.0.0 only when the
# stack genuinely runs somewhere else — a VM, a remote Docker host, WSL2 reached from
# Windows — and prefer setting AIRFLOW_JWT_SECRET at the same time.
AIRFLOW_BIND=127.0.0.1

# Overrides the `signal-local-dev` default. Only load-bearing if AIRFLOW_BIND is widened.
AIRFLOW_JWT_SECRET=

# Airflow's encryption key for Variables and Connections. Every container has to share one:
# left unset each generates its own, and a Variable written by a task then reads back as
# "does not exist" everywhere else. docker-compose.yml carries a committed default so the
# stack works out of the box; set this to keep a per-machine key that survives a recreate.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Credentials are never set here. The AWS CLI's own store is the only place they live;
# docker-compose mounts it read-only into the Airflow containers.
AWS_REGION=us-east-1
